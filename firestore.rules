rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAccountActive() {
      return isAuthenticated() && (getUserData().status == 'ACTIVE' || getUserData().status == 'PENDING');
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Usernames collection rules (for fast uniqueness check)
    match /usernames/{username} {
      allow read: if true; // allow unauthenticated check for signup/username availability
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Invitations collection rules
    match /invitations/{invitationId} {
      allow read: if true; // allow checking invitation validity by hash token
      allow create, update, delete: if isAdmin();
    }

    // Audit Logs collection rules
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are append-only / immutable
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if isAuthenticated() && isAccountActive();
    }
  }
}
